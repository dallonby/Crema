# Copy to `.env`, fill in the secrets, then `docker compose --profile prod up -d`.
#
# `.env` is gitignored — never commit it.

# Random string (32+ chars). Used to sign session JWTs.
JWT_SECRET=change-me-to-a-long-random-string

# Apple identity token audience — your iOS bundle id.
APPLE_CLIENT_ID=coffee.crema.app

# Apple App ID for Universal Links discovery.
# Format: <team-id>.<bundle-id>
APPLE_APP_ID=YDGQZ6G5L9.coffee.crema.app

# Comma-separated Google OAuth client ids (iOS, Android, web).
# Leave empty to disable Google sign-in.
GOOGLE_CLIENT_IDS=

# Android App Links discovery (optional).
ANDROID_PACKAGE_NAME=coffee.crema.app
ANDROID_SHA256_FINGERPRINTS=

# The user-facing URL the API will live at. Used in share-link generation.
PUBLIC_BASE_URL=https://api.caffecremalabs.com

# CORS allowlist — comma-separated origins, or `*` to allow all.
CORS_ORIGINS=*
